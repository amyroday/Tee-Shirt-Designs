# Copy this file to .env for local runs. Never commit the real .env file.

# Printify: generate at https://printify.com -> Account -> Connections -> API
PRINTIFY_TOKEN=
PRINTIFY_SHOP_ID=

# Etsy Open API v3: register an app at https://developer.etsy.com, then run
# scripts/etsy_oauth_setup.py once to obtain ETSY_REFRESH_TOKEN.
# ETSY_API_KEY is the app's "Keystring", ETSY_SHARED_SECRET is its "Shared secret".
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_REFRESH_TOKEN=

# GitHub: a fine-grained Personal Access Token with this repo's
# "Secrets: write" permission, so the pipeline can persist Etsy's rotated
# refresh token back into repo secrets after each run (Etsy issues a new
# refresh token every time the old one is used -- the old one stops working).
# Only needed in CI; not required for local dry runs.
GH_PAT_FOR_SECRETS=
GITHUB_REPOSITORY=amyroday/Tee-Shirt-Designs

# Anthropic: create at https://console.anthropic.com (billed separately from
# your Claude subscription).
ANTHROPIC_API_KEY=
